# No secrets required for local JSON-file store.
# Add real secrets here if you later connect a database / payment gateway.

# --- SMS provider (BulksmsBD) ---
# When BULKSMSBD_API_KEY + BULKSMSBD_SENDER_ID are both set, the rider OTP
# flow hits the real BulksmsBD HTTP API. When either is missing, it falls
# back to the console adapter (logs to stdout + data/outbox/sms.jsonl).
#
# BULKSMSBD_API_KEY=8vbu0ouNbZNeNKL2czo2
# BULKSMSBD_SENDER_ID=8809648910609
# BULKSMSBD_URL=http://bulksmsbd.net/api/smsapi   # default, override only if BulksmsBD changes the endpoint
# BULKSMSBD_TIMEOUT_MS=8000                       # per-request timeout